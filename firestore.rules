rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: Apakah pengguna sudah login
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function: Apakah pengguna adalah Admin
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email in ['muhbar@fitbay.id', 'nessa@fitbay.id', 'akbar@fitbay.id', 'nesa@fitbay.id', 'admin@admin.id'] ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // 1. Transaksi Penjualan
    // Read diizinkan publik (untuk rekonsiliasi portal pemilik)
    // Staff & Admin bisa menambah dan mengedit, HANYA Admin yang berhak menghapus
    match /transactions/{transactionId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }
    
    // 2. Data Inventaris & Stok Barang
    // Read diizinkan publik (untuk cek status barang titipan)
    // Staff & Admin bisa menambah dan mengedit, HANYA Admin yang berhak menghapus
    match /inventory/{itemId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // 3. Pemilik Barang (Titipan)
    // Read diizinkan publik (untuk verifikasi data pemilik di portal)
    // Staff & Admin bisa menambah/edit, HANYA Admin yang berhak menghapus
    match /owners/{ownerId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // 4. Riwayat Penarikan Saldo
    // Read diizinkan publik (untuk riwayat pencairan pemilik)
    // HANYA Admin yang berhak mencatat/mengubah/menghapus penarikan
    match /withdrawals/{withdrawalId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. Profil Pengguna & Hak Akses (Sensitif)
    // Pengguna yang login bisa membaca profil tim & update profilnya sendiri
    match /users/{userId} {
      allow read, create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // 6. Pengaturan Sistem (Persentase Pembagian Hasil)
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Blokir total untuk koleksi liar lainnya
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
